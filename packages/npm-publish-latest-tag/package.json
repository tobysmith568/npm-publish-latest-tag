{
  "name": "npm-publish-latest-tag",
  "version": "0.0.0",
  "description": "Library for getting a tag value to supply to the npm publish command so that updates to old major versions don't automatically get given the 'latest' tag",
  "keywords": [
    "npm",
    "publish",
    "version",
    "latest",
    "tag",
    "semver"
  ],
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "version": "bun pm pkg set version=$VERSION",
    "pack": "bun pm pack",
    "publish": "npm publish *.tgz --access public --provenance --tag $NPM_TAG"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  },
  "author": {
    "name": "Toby Smith",
    "email": "contact@tobythe.dev",
    "url": "https://tobysmith.uk"
  },
  "homepage": "https://github.com/tobysmith568/npm-publish-latest-tag/blob/main/packages/npm-publish-latest-tag/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysmith568/npm-publish-latest-tag.git",
    "directory": "packages/npm-publish-latest-tag"
  },
  "bugs": {
    "url": "https://github.com/tobysmith568/npm-publish-latest-tag/issues"
  }
}
